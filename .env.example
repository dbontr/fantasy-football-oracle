# HTTP server
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
ORACLE_TRUST_PROXY=false

# Data season and refresh cadence
ORACLE_SEASON=2026
ORACLE_REFRESH_INTERVAL_MS=21600000
ORACLE_MINIMUM_REFRESH_MS=600000

# Worker-thread compute budget
# Default: min(4, available CPU cores - 1)
ORACLE_WORKERS=4
ORACLE_MAX_QUEUE=64
ORACLE_TASK_TIMEOUT_MS=45000

# Draft simulation depth
ORACLE_DEFAULT_SIMULATIONS=15000
ORACLE_MAX_SIMULATIONS=50000

# Request protection
ORACLE_BODY_LIMIT_BYTES=2500000

# Optional persistent directory for refreshed source data
# Docker example: /app/data/runtime
# Azure Linux App Service example: /home/oracle-runtime
ORACLE_RUNTIME_DIR=

# Optional bearer token for POST /api/data/refresh.
# Without a token, manual refresh is allowed only from loopback.
ORACLE_ADMIN_TOKEN=

# Native C++ analysis engine
# Leave ORACLE_NATIVE_BINARY empty to use native/bin/oracle-engine(.exe).
ORACLE_NATIVE_BINARY=
ORACLE_NATIVE_WORKERS=4
ORACLE_NATIVE_DISABLED=false
# Production containers should require native startup; local development may fall back to JS.
ORACLE_NATIVE_REQUIRED=false

# Championship architecture control plane
# Defaults under ORACLE_RUNTIME_DIR/platform.
ORACLE_PLATFORM_RUNTIME_DIR=
ORACLE_ARTIFACT_MANIFEST=
# Set true in production after the committed manifest is present.
ORACLE_STRICT_ARTIFACT_INTEGRITY=false
ORACLE_BACKUP_RPO_MS=86400000
ORACLE_MAX_CHAMPIONSHIP_ACTIONS=24
ORACLE_CHAMPIONSHIP_TIMEOUT_MS=180000

# Service-level objectives
ORACLE_HTTP_P95_SLO_MS=3000
ORACLE_CHAMPIONSHIP_P95_SLO_MS=180000
ORACLE_MIN_PLAYER_COVERAGE=600

# Recovery tooling. Never commit the passphrase.
# Windows separates multiple targets with ; and Linux/macOS with :
ORACLE_BACKUP_TARGETS=
ORACLE_BACKUP_PASSPHRASE=
